{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: run",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--no-warnings", "--env-file-if-exists=.env"],
      "program": "${workspaceFolder}/backend/src/server.ts",
      "env": {
        "SESSION_SECRET": "local-development-secret-not-for-real-use-0123456789"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Backend: tests",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--no-warnings", "--test", "test/*.test.ts"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
