# Copy to .env and fill in. Never commit .env.

HOST=127.0.0.1
PORT=8787

# At least 32 random characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=

DB_PATH=./data/scrolltax.db
BACKUP_DIR=./data/backups
LOG_DIR=./logs
# Each log file is capped at this size. Two files are kept, so the total is twice this.
LOG_MAX_BYTES=26214400
LOG_LEVEL=info

# "fake" accepts made up tokens and is for local work and tests only.
# "real" checks Sign in with Apple tokens and App Store transactions properly.
APPLE_MODE=fake
# Needed for APPLE_MODE=real
APPLE_BUNDLE_ID=
# Path to Apple's root certificate (the public one, from Apple's PKI page)
APPLE_ROOT_CERT_PATH=
# Payments stay in the sandbox for now. Do not change this before launch.
APPLE_ENVIRONMENT=Sandbox

# The deal's numbers. Change any of them here.
PRODUCT_ID=app.scrolltax.unlock15
PRICE_MINOR=99
CURRENCY=EUR
UNLOCK_MINUTES=15
DAILY_UNLOCK_LIMIT=4
LEAVE_WAIT_HOURS=24
MIN_AGE=18
TERMS_VERSION=2026-11-draft
SUPPORT_EMAIL=
