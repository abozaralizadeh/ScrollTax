{
  "name": "scrolltax-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "report": "node --env-file-if-exists=.env scripts/report.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
